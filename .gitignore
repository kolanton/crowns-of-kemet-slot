# Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.csproj
*.sln
*.slnx

# Raw build output; the served copy lives in docs/ and must stay tracked, so this
# is anchored to the root rather than matching Build/ at any depth.
/Build/

# The published build is encrypted (see tools/encrypt-build.ps1). A plaintext one in
# docs/ would be served next to it and make the password gate pointless, so the
# unencrypted names can never be committed again.
/docs/Build/*.unityweb

# Third-party art, redistributable only through the Unity Asset Store.
# Acquire it free from the store link in README.md, then import it here.
Assets/RetroStyle Games/
Assets/RetroStyle Games.meta

# Scratch folders used to inspect pack art locally. These hold copies of
# licensed Asset Store files and must never be published.
/docs/_ui/
/docs/_bg_inspect.png

# Third-party audio, licensed through the Unity Asset Store. Acquire it free
# from the link in README.md and import it; it must not be redistributed here.
Assets/UI SFX Free Pack/
Assets/UI SFX Free Pack.meta

# Third-party music, licensed through the Unity Asset Store. Acquire it free
# from the link in README.md and import it; it must not be redistributed here.
Assets/Desert Music Pack/
Assets/Desert Music Pack.meta

# Third-party sound effects (CC0 content, delivered via the Asset Store). Acquire
# it free from the link in README.md and import it.
Assets/Casual Game Sounds U6/
Assets/Casual Game Sounds U6.meta

# Packaged build for upload to a gated host; regenerate from docs/ as needed.
/crowns-of-kemet-web.zip

# Scratch copy of the site, encrypted with a throwaway password for local testing.
/.test-site/
